# 服务监听端口
PORT=3000
# 运行时数据目录（数据库、图片、音频），相对路径基于项目根目录
DATA_DIR=./data

# 视觉识别 provider：ark（火山方舟真实识别）| mock（无密钥时本地假数据，见 lib/vlm/mock.ts）
VLM_PROVIDER=ark
# 火山方舟 API Key，控制台 -> API Key 管理 处创建：https://console.volcengine.com/ark
ARK_API_KEY=
# 火山方舟推理服务地址，一般不需要改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 火山方舟控制台里创建的推理接入点 ID（Endpoint ID）或模型名
ARK_MODEL=

# 语音合成 provider：volcano（火山语音真实合成）| mock（无密钥时生成提示音，可听出三遍与间隔的真实节奏）
TTS_PROVIDER=volcano
# 火山语音合成大模型 2.0 (Seed-TTS) 的 unidirectional 接口地址，一般不需要改
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# 火山语音技术控制台 -> API Key 管理 里创建的 Key：https://console.volcengine.com/speech
VOLC_TTS_API_KEY=
# 资源 ID，固定为 seed-tts-2.0（豆包语音合成大模型 2.0），一般不需要改
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 音色 ID，在火山语音控制台的音色库里选择，如 zh_female_vv_uranus_bigtts
VOLC_TTS_SPEAKER=
# 合成音频的采样率，单位 Hz
VOLC_TTS_SAMPLE_RATE=24000

# 听写时每个词重复播放的次数
TTS_REPEAT=3
# 重复播放之间的间隔，单位毫秒
TTS_GAP_MS=1500
# 播放语速，0.8 或 1.0
TTS_SPEED=1.0
