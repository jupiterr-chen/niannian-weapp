#############################################################
#  ⚠️  警告：这是部署到目标机时的模板文件 —— 所有值一律留空！
#
#  真实密钥请填到同目录下的 .env.local（docker-compose.yml 用
#  `env_file: .env.local` 在运行时把它注入容器，不会打进镜像层）。
#  不要把真实值填到这个 .env.docker.example 文件里。
#
#  部署步骤：
#    1. 把整个项目目录（含 Dockerfile / docker-compose.yml）拷到目标机
#       的部署目录下
#    2. cp .env.docker.example .env.local
#    3. 编辑 .env.local，按下面每行的注释去对应控制台取值填进去
#    4. docker compose up -d --build
#
#  DATA_DIR / PORT / TZ 这三项在 docker-compose.yml 里已经用 environment
#  显式钉死为容器内该用的值（/data、3000、Asia/Shanghai），这里填不填、
#  填什么都不影响容器实际行为，只是为了这份文件本身的完整性列出来。
#############################################################

# 服务监听端口（容器内固定用 3000，见 docker-compose.yml；这里可留空）
PORT=

# 运行时数据目录（容器内固定用 /data，见 docker-compose.yml；这里可留空）
DATA_DIR=

# ---------- 视觉识别（火山方舟 Ark，用于识别作业照片） ----------
# provider：ark（火山方舟真实识别）| mock（无密钥时本地假数据）
VLM_PROVIDER=ark
# 火山方舟 API Key，控制台 -> API Key 管理 处创建：https://console.volcengine.com/ark
ARK_API_KEY=
# 火山方舟推理服务地址，一般不需要改
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 火山方舟控制台里创建的推理接入点 ID（Endpoint ID）或模型名
ARK_MODEL=

# ---------- 语音合成（豆包语音大模型 2.0 / Seed-TTS） ----------
# provider：volcano（火山语音真实合成）| mock（无密钥时生成提示音）
TTS_PROVIDER=volcano
# 火山语音合成大模型 2.0 (Seed-TTS) 的 unidirectional 接口地址，一般不需要改
VOLC_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# 火山语音技术控制台 -> API Key 管理 里创建的 Key：https://console.volcengine.com/speech
VOLC_TTS_API_KEY=
# 资源 ID，固定为 seed-tts-2.0（豆包语音合成大模型 2.0），一般不需要改
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
# 音色 ID，在火山语音控制台的音色库里选择，如 zh_female_vv_uranus_bigtts
VOLC_TTS_SPEAKER=
# 合成音频的采样率，单位 Hz，一般不需要改
VOLC_TTS_SAMPLE_RATE=24000

# ---------- 听写播报参数 ----------
# 每个词重复播放的次数
TTS_REPEAT=3
# 重复播放之间的间隔，单位毫秒
TTS_GAP_MS=1500
# 播放语速，0.8 或 1.0
TTS_SPEED=1.0
