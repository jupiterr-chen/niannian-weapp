<view class="page">
  <view class="title-row">
    <text class="page-title">上传今天的作业</text>
    <text wx:if="{{testMode}}" class="test-badge">🧪 测试模式</text>
  </view>

  <view wx:if="{{error}}" class="notice-danger">
    <text class="l">{{error}}</text>
    <button class="btn-secondary reset-btn" hover-class="btn-secondary-press" bindtap="resetAll">
      <text class="btn-label">重新选图</text>
    </button>
  </view>

  <view class="upload-block">
    <block wx:if="{{!submitting}}">
      <button class="pick-btn" hover-class="pick-press" bindtap="chooseImages">
        <text class="pick-emoji">📸</text>
        <text class="pick-text l">{{images.length === 0 ? "点这里拍照或选照片" : "继续添加照片"}}</text>
        <text class="pick-sub l">可多选</text>
      </button>

      <view wx:if="{{images.length > 0}}" class="thumbs">
        <view wx:for="{{images}}" wx:key="id" class="thumb">
          <image class="thumb-img" src="{{item.path}}" mode="aspectFill" />
          <view class="thumb-del" data-id="{{item.id}}" catchtap="removeImage">×</view>
        </view>
      </view>
    </block>

    <view wx:if="{{submitting}}" class="loading">
      <view class="spinner" />
      <text class="loading-text l">正在认字，大约 10 秒…</text>
    </view>
  </view>

  <button class="btn-pop btn-primary" hover-class="btn-pop-press" bindtap="submit" disabled="{{(!testMode && images.length === 0) || submitting}}">
    <text class="btn-label">{{testMode ? "🧪 用上次词表测试" : (submitting ? "正在识别…" : "🔍 开始识别")}}</text>
  </button>
</view>
