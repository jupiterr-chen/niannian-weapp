.upload-block {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.pick-btn {
  width: 100%;
  min-height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4px dashed var(--border);
  border-radius: 32rpx;
  background: var(--bg-elevated);
  color: var(--fg-muted);
  font-size: 22px;
  font-weight: 500;
}
.reset-btn {
  margin-top: 24rpx;
}
.thumbs {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
}
.thumb {
  position: relative;
  aspect-ratio: 1;
  border: 2px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}
.thumb-img {
  width: 100%;
  height: 100%;
}
.thumb-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}
.spinner {
  width: 56px;
  height: 56px;
  border: 4px solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.loading-text {
  font-size: 22px;
  font-weight: 500;
}
