.upload-block {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.pick-btn {
  width: 100%;
  min-height: 260px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 4px dashed var(--orange);
  border-radius: 28px;
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 4px 0 rgba(60, 45, 20, 0.06);
  transition: transform 0.06s ease;
}
.pick-press {
  transform: translateY(4px);
}
.pick-emoji {
  font-size: 64px;
  line-height: 1.1;
}
.pick-text {
  font-size: 22px;
  font-weight: 700;
}
.pick-sub {
  font-size: 15px;
  color: var(--muted);
}
.reset-btn {
  margin-top: 24rpx;
}
.thumbs {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
}
.thumb {
  position: relative;
  aspect-ratio: 1;
  border: 3px solid var(--card);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 3px 0 rgba(60, 45, 20, 0.1);
}
.thumb-img {
  width: 100%;
  height: 100%;
}
.thumb-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(58, 52, 44, 0.7);
  color: #ffffff;
  font-size: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}
.spinner {
  width: 56px;
  height: 56px;
  border: 6px solid var(--orange-soft);
  border-top-color: var(--orange);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.loading-text {
  font-size: 22px;
  font-weight: 600;
}
