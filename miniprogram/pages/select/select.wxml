<view class="page select-page">
  <view wx:if="{{state === 'loading'}}" class="state-block"><text class="muted">正在加载识别结果…</text></view>

  <view wx:elif="{{state === 'missing'}}" class="state-block">
    <text>找不到这份识别结果了，可能是链接不对或者作业记录已经不在了。</text>
    <button class="btn-pop btn-primary state-btn" bindtap="goUpload">重新上传</button>
  </view>

  <block wx:else>
    <text class="page-title">{{title}}</text>

    <view class="summary-bar">
      <text class="dot dot-green"></text>
      <text class="summary-text">必听 {{requiredCount}}</text>
      <text class="dot dot-orange"></text>
      <text class="summary-text">选听 {{optionalCount}}</text>
      <text class="summary-eq">＝ {{totalCount}} 个</text>
    </view>

    <view wx:if="{{pageError}}" class="notice-danger"><text>{{pageError}}</text></view>
    <view wx:if="{{correctionNotice}}" class="notice-success"><text>{{correctionNotice}}</text></view>

    <view class="section">
      <view class="section-head">
        <text class="heading">必听词语</text>
        <text class="section-tag tag-green">不能取消</text>
      </view>
      <view class="chip-grid">
        <view wx:for="{{required}}" wx:key="id" class="wcard wcard-lock {{item.pinyinUncertain ? 'wcard-warn' : ''}}">
          <view class="wcard-body">
            <view class="pw pw-on-soft">
              <text class="pinyin pw-py">{{item.pinyin}}</text>
              <text class="pw-tx">{{item.text}}</text>
            </view>
          </view>
          <view class="wcard-acts">
            <view class="act {{previewingId === item.id ? 'act-busy' : ''}}" data-id="{{item.id}}" bindtap="previewWord">{{previewingId === item.id ? "…" : "🔊"}}</view>
            <view class="act act-edit" data-word="{{item.text}}" data-id="{{item.id}}" bindtap="correctWord">✏️</view>
          </view>
          <view wx:if="{{item.pinyinUncertain}}" class="wcard-flag">读音需确认</view>
          <view wx:elif="{{degradedId === item.id}}" class="wcard-flag">读音可能不准</view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="heading">生字组词</text>
        <button class="pick-btn {{picking ? '' : 'pick-press'}}" bindtap="handlePick" disabled="{{picking}}">{{picking ? "选词中…" : "✨ 帮我选"}}</button>
      </view>

      <view wx:for="{{rows}}" wx:for-item="row" wx:key="rowIndex" class="card row-card">
        <view class="row-head">
          <view class="row-char">{{row.char}}</view>
          <view class="row-meta">
            <text class="pinyin row-pinyin">{{row.pinyin}}</text>
            <text class="row-index">第 {{row.rowIndex + 1}} 行</text>
          </view>
        </view>
        <view class="chip-grid">
          <view wx:for="{{row.words}}" wx:for-item="word" wx:key="id" class="wcard {{word.duplicateOfRequired ? 'wcard-dup' : word.selected ? 'wcard-sel' : ''}} {{word.pinyinUncertain ? 'wcard-warn' : ''}}">
            <view wx:if="{{word.selected && !word.duplicateOfRequired}}" class="wcard-check">✓</view>
            <view class="wcard-body" data-row="{{row.rowIndex}}" data-id="{{word.id}}" data-dup="{{word.duplicateOfRequired}}" bindtap="selectWord">
              <view class="pw pw-on-soft {{word.selected ? 'pw-on-fill' : ''}}">
                <text class="pinyin pw-py">{{word.pinyin}}</text>
                <text class="pw-tx">{{word.text}}</text>
              </view>
            </view>
            <view class="wcard-acts">
              <view class="act {{previewingId === word.id ? 'act-busy' : ''}}" data-id="{{word.id}}" bindtap="previewWord">{{previewingId === word.id ? "…" : "🔊"}}</view>
              <view class="act act-edit" data-word="{{word.text}}" data-id="{{word.id}}" bindtap="correctWord">✏️</view>
            </view>
            <view wx:if="{{word.duplicateOfRequired}}" class="wcard-flag">已在必听</view>
            <view wx:elif="{{word.pinyinUncertain}}" class="wcard-flag">读音需确认</view>
            <view wx:elif="{{degradedId === word.id}}" class="wcard-flag">读音可能不准</view>
          </view>
        </view>
        <text wx:if="{{!row.hasEligible}}" class="row-note">这一行的组词都已经在必听词里了，不用另外选。</text>
      </view>
    </view>

    <view class="bottom-bar">
      <button class="btn-pop btn-primary btn-success cta" hover-class="btn-pop-press" bindtap="startDictation" disabled="{{creating}}">{{creating ? "正在准备…" : "🚀 开始听写"}}</button>
    </view>
  </block>

  <!-- 读音修正（§5.3 第 3 层兜底） -->
  <view wx:if="{{correction}}" class="modal-mask" catchtap="cancelCorrection">
    <view class="modal-panel card" catchtap="noop">
      <text class="modal-title">「{{correction.word}}」读音不对？</text>
      <text class="modal-sub">换一个读音相同或相近的词，以后就用这个词来发音。</text>
      <input class="modal-input" value="{{correction.value}}" bindinput="onCorrectionInput" />
      <view class="modal-row">
        <button class="btn-secondary modal-cancel" hover-class="btn-secondary-press" bindtap="cancelCorrection">取消</button>
        <button class="btn-pop btn-primary modal-ok" hover-class="btn-pop-press" bindtap="submitCorrection" disabled="{{correctionSubmitting || !correction.canSubmit}}">{{correctionSubmitting ? "保存中…" : "确认修正"}}</button>
      </view>
    </view>
  </view>
</view>
