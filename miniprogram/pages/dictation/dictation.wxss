/* 听写页（D-25/D-26）：固定一屏、禁止滚动。
   糖果色版本：暖底 + 白卡状态区 + 立体按钮，弹性分配与 v1 相同：
   状态区（孩子要看的）> 按钮区 > 序号 > 结束入口。 */
.dictation {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  gap: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg);
}

.state-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  text-align: center;
  font-size: 22px;
}
.state-btn {
  width: 80%;
}

/* 解锁遮罩（铁律 4） */
.unlock {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 48rpx;
}
.unlock-emoji {
  font-size: 96px;
  line-height: 1;
}
.unlock-text {
  font-size: 26px;
  font-weight: 700;
  text-align: center;
}
.unlock-btn {
  width: 80%;
}

.pane {
  flex: 1 1 0;
  min-height: 0;
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.pane-info {
  flex-grow: 1.3;
}

/* 头部：序号徽章 + 进度条 */
.head {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

/* 进度行：进度条占满剩余宽度，计时器胶囊固定在右端，同高对齐 */
.bar-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.timer {
  flex: none;
  font-family: Menlo, Consolas, monospace;
  font-size: 16px;
  font-weight: 600;
  color: var(--muted);
  background: var(--card);
  border-radius: 9999px;
  padding: 8rpx 22rpx;
  box-shadow: 0 3px 0 rgba(60, 45, 20, 0.08);
}
.seq-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  white-space: nowrap;
}
.seq-label {
  font-size: 24px;
  font-weight: 600;
  color: var(--muted);
}
.seq-number {
  font-size: 72px;
  font-weight: 800;
  line-height: 1;
  color: var(--orange);
}
.bar {
  width: 100%;
  height: 20rpx;
  border-radius: 9999px;
  background: var(--card);
  box-shadow: inset 0 2px 4px rgba(60, 45, 20, 0.1);
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 9999px;
  background: var(--green);
  transition: width 0.2s ease;
}

/* 状态区：白卡大图标，整屏视觉主角 */
.status {
  flex: 1 1 auto;
  min-height: 0;
  background: var(--card);
  border-radius: 28px;
  box-shadow: 0 5px 0 rgba(60, 45, 20, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  text-align: center;
  padding: 24rpx;
}
.status-icon {
  font-size: 88px;
  line-height: 1.1;
}
.status-text {
  font-size: 32px;
  font-weight: 800;
  white-space: nowrap;
}
.status-sub {
  font-size: 20px;
  color: var(--muted);
}
.status-pinyin {
  font-size: 26px;
  font-weight: 700;
  color: #B7791F;
  background: var(--yellow-soft);
  border-radius: 9999px;
  padding: 4rpx 32rpx;
}

/* 按钮区 */
.pane-actions {
  flex-grow: 1;
}
.buttons {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 24rpx;
}
/* 「写好了」是听写中的高频主操作：独占一行、最大最醒目 */
.btn-main-success {
  width: 100%;
  min-height: 88px;
  font-size: 26px;
  background: var(--green);
  box-shadow: 0 5px 0 var(--green-edge);
  border-radius: 20px;
}

.btn-row {
  display: flex;
  width: 100%;
  gap: 24rpx;
}
.btn-row .btn-secondary {
  flex: 1;
}
.end-zone {
  flex: 0 0 auto;
  display: flex;
  justify-content: center;
  padding-top: 8rpx;
}
.end-trigger {
  min-height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  font-size: 15px;
  color: var(--muted);
  text-decoration: underline;
}

/* 结束确认面板（D-23） */
.end-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(58, 52, 44, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
}
.end-panel {
  width: 100%;
  max-width: 960rpx;
  background: var(--card);
  border-radius: 28px;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.2);
}
.end-title {
  font-size: 24px;
  font-weight: 800;
  text-align: center;
}
.end-sub {
  font-size: 22px;
  color: var(--muted);
  text-align: center;
}
.end-stop {
  min-height: 52px;
  font-size: 16px;
  color: var(--red);
  background: transparent;
  border: 2px solid var(--line);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}
