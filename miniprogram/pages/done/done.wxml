<view class="page done">
  <view class="done-block">
    <!-- 庆祝卡片：弹跳入场 + 彩带落下，按表现授予称号 -->
    <view wx:if="{{result}}" class="celebrate card">
      <view class="confetti-box">
        <text class="confetti cf1">🎉</text>
        <text class="confetti cf2">⭐</text>
        <text class="confetti cf3">✨</text>
        <text class="confetti cf4">🎊</text>
        <text class="confetti cf5">💛</text>
        <text class="confetti cf6">⭐</text>
      </view>
      <text class="cele-badge">{{badge}}</text>
      <text class="cele-title">{{title}}</text>
      <text wx:if="{{durationText}}" class="cele-sub">⏱ 本次用时 {{durationText}}</text>
    </view>

    <text wx:if="{{result === null && !error}}" class="muted">正在统计…</text>
    <text wx:if="{{error}}" class="muted">{{error}}</text>
  </view>

  <view wx:if="{{result}}" class="done-stats">
    <view class="stat-pill stat-blue">
      <text class="stat-num">{{result.total}}</text>
      <text class="stat-label">总共</text>
    </view>
    <view class="stat-pill stat-green">
      <text class="stat-num">{{result.total - result.skipped}}</text>
      <text class="stat-label">写好了</text>
    </view>
    <view class="stat-pill stat-orange">
      <text class="stat-num">{{result.hintCount}}</text>
      <text class="stat-label">用过提示</text>
    </view>
  </view>

  <view wx:if="{{result && result.skippedWords.length > 0}}" class="done-block">
    <view class="focus-card">
      <text class="heading focus-title">⭐ 重点看</text>
      <view class="chip-grid focus-grid">
        <view wx:for="{{result.skippedWords}}" wx:key="id" class="pw pw-sm">
          <text class="pinyin pw-py">{{item.pinyin}}</text>
          <text class="pw-tx">{{item.text}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="done-cta">
    <button class="btn-pop btn-primary" hover-class="btn-pop-press" bindtap="goHome"><text class="btn-label">回到首页</text></button>
  </view>
</view>
