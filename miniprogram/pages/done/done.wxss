.done {
  gap: 16rpx;
}
.done-block {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  text-align: center;
}
.done-title {
  font-size: 40px;
  font-weight: 700;
}
.focus-card {
  width: 100%;
  border: 2px solid var(--warning-border);
  background: var(--warning-bg);
  border-radius: 16px;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.focus-title {
  color: var(--warning);
}
.focus-grid {
  gap: 32rpx;
}
.done-cta {
  flex: 0 0 auto;
  padding-top: 24rpx;
}
