.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.item {
  border: 2px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}
.item-head {
  min-height: 88px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 40rpx;
}
.item-title {
  font-size: 22px;
  font-weight: 600;
}
.item-sub {
  font-size: 17px;
  color: var(--fg-muted);
}
.item-detail {
  border-top: 2px solid var(--border);
  padding: 32rpx;
}
.detail-grid {
  gap: 32rpx;
}
.detail-word {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.detail-status {
  font-size: 15px;
  color: var(--fg-muted);
}
.detail-skipped {
  color: var(--warning);
}
.history-cta {
  margin-top: auto;
  padding-top: 32rpx;
}
