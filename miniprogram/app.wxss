/**
 * 设计系统 v2 —— 儿童教育风（2026-09-12 重设计）。
 * 暖米色底 + 糖果色卡片 + 立体按钮（下缘深色边，按压下沉），字号沿用
 * Web 版 §9 硬指标的手机端真实值（正文 22px、主操作 88px、序号 72px）。
 * 语义色成对出现：主色 + edge（立体按钮的下缘色）。
 */
page {
  --bg: #FFF6EA;
  --card: #ffffff;
  --ink: #3A342C;
  --muted: #9A8F7E;
  --line: #F0E4D2;

  --orange: #FF8A3D;
  --orange-edge: #E0661B;
  --orange-soft: #FFEEDC;

  --green: #3EBD7A;
  --green-edge: #1F9A5C;
  --green-soft: #E3F8EC;

  --blue: #4D9FFF;
  --blue-edge: #2F7FE0;
  --blue-soft: #E8F2FF;

  --yellow: #FFC53D;
  --yellow-edge: #E0A41F;
  --yellow-soft: #FFF4D6;

  --red: #F0564C;
  --red-soft: #FFE9E4;

  background: var(--bg);
  color: var(--ink);
  font-size: 22px;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  height: 100%;
}

/* 拼音：等宽字体、永不换行，太长省略号（省略比断行体面） */
.pinyin {
  font-family: Menlo, Consolas, monospace;
  letter-spacing: 0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* 汉字+拼音竖排小组（PinyinWord 等价物） */
.pw {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}
.pw-py {
  font-size: 13px;
  line-height: 1.2;
}
.pw-tx {
  font-size: 26px;
  font-weight: 700;
  line-height: 1.3;
}
.pw-sm .pw-tx {
  font-size: 22px;
}
.pw-on-soft .pw-py {
  color: var(--muted);
}

/* 按钮文字：显式包一层 <text class="btn-label">。裸文字在 display:flex 的
   button 里是匿名 flex 子项，中文字符间都可断行，会被引擎随机折行；
   包一层并禁断行后，短标签永远单行，超宽走省略号。 */
.btn-label {
  /* 关键：显式占满整行并居中，不作为可收缩的 flex 子项参与弹性计算。
     真机上 overflow:hidden 会让 flex 子项的自动最小宽度归零，标签会被
     压出"上传…"这样的截断——宽度定死为 100% 后彻底免疫。 */
  display: block;
  width: 100%;
  text-align: center;
  white-space: nowrap;
  word-break: keep-all;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
}

/* 语义分行的长句：每行一个 <text class="l">，断点由我们定，不靠引擎 */
.l {
  display: block;
}

/* 白色圆角卡片 */
.card {
  background: var(--card);
  border-radius: 24px;
  box-shadow: 0 4px 0 rgba(60, 45, 20, 0.06);
}

/* 立体按钮：下缘用同色深边（box-shadow 0 6px 0 edge），按压下沉 */
.btn-pop {
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #ffffff;
  /* 统一内边距：真机上原生 button 的默认 padding 各版本不一，显式钉死 */
  padding: 0 24rpx;
  box-sizing: border-box;
  transition: transform 0.06s ease, box-shadow 0.06s ease;
}
.btn-pop-press {
  transform: translateY(5px);
  box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2) !important;
}
.btn-pop[disabled] {
  opacity: 0.55;
}

/* 主操作（≥88px、字 24px） */
.btn-primary {
  min-height: 88px;
  font-size: 24px;
  background: var(--orange);
  box-shadow: 0 6px 0 var(--orange-edge);
}
/* 次操作（≥88px、字 20px） */
.btn-secondary {
  min-height: 88px;
  font-size: 20px;
  font-weight: 600;
  background: var(--card);
  color: var(--ink);
  border-radius: 20px;
  box-shadow: 0 5px 0 rgba(60, 45, 20, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  transition: transform 0.06s ease, box-shadow 0.06s ease;
}
.btn-secondary-press {
  transform: translateY(4px);
  box-shadow: 0 1px 0 rgba(60, 45, 20, 0.12) !important;
}
.btn-secondary[disabled] {
  opacity: 0.55;
}
.btn-success {
  background: var(--green);
  box-shadow: 0 5px 0 var(--green-edge);
  color: #ffffff;
}
.btn-blue {
  background: var(--blue);
  box-shadow: 0 5px 0 var(--blue-edge);
}

/* 首页英雄按钮：高 150px、字 28px，橙色糖果感 */
.btn-hero {
  min-height: 150px;
  font-size: 28px;
  background: var(--orange);
  box-shadow: 0 8px 0 var(--orange-edge);
  border-radius: 28px;
}

/* 页面容器 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.page-title {
  font-size: 28px;
  font-weight: 800;
}
.heading {
  font-size: 24px;
  font-weight: 800;
}
.muted {
  color: var(--muted);
}

/* 提示条 */
.notice-danger {
  background: var(--red-soft);
  color: var(--red);
  border-radius: 16px;
  padding: 24rpx;
  font-size: 22px;
}
.notice-success {
  background: var(--green-soft);
  color: var(--green-edge);
  border-radius: 16px;
  padding: 24rpx;
  font-size: 22px;
}

/* 词语卡片栅格：手机 3 列（v2 调整：卡片紧凑化后 3 列可读性达标） */
.chip-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}
